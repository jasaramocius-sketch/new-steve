.has-submenu:hover .dropdown-menu {
  opacity: 1;
  visibility: visible;
  top: 130%
}

.has-submenu .dropdown-menu {
  display: block;
  top: 170%;
  opacity: 0;
  visibility: hidden;
  -webkit-transition: all .3s ease-in;
  -o-transition: all .3s ease-in;
  transition: all .3s ease-in;
  min-width: 220px;
  background: var(--white-color)
}

.has-submenu .dropdown-menu li {
  margin: 0;
  padding: 0;
  line-height: 2.1;
  position: relative;
  list-style: none
}

.has-submenu .dropdown-menu li::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0;
  height: 2px;
  background: var(--blue-color);
  opacity: 0;
  visibility: hidden;
  -webkit-transition: all .3s ease-in;
  -o-transition: all .3s ease-in;
  transition: all .3s ease-in
}

.has-submenu .dropdown-menu li:hover::after {
  opacity: 1;
  width: 20px;
  visibility: visible
}

.has-submenu .dropdown-menu li:last-child::after {
  display: none
}

.has-submenu .dropdown-menu li:last-child::before {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 2px;
  background: var(--primary)
}

.has-submenu .dropdown-menu li .dropdown-item {
  display: block !important;
  height: auto !important;
  padding: 0 20px !important;
  border: none !important;
  border-bottom: none !important;
  color: var(--text-color) !important;
  text-transform: capitalize !important;
  font-size: 16px !important;
  font-weight: 400 !important;
  font-family: inherit !important;
  background: 0 0 !important;
  position: relative;
  line-height: inherit !important;
  transition: color .3s ease-in
}

.has-submenu .dropdown-menu li:hover .dropdown-item {
  color: var(--primary) !important;
  background: 0 0 !important
}

.has-submenu .dropdown-menu li .dropdown-item::after {
  display: none !important
}

.has-submenu .dropdown-menu li .dropdown-item::before {
  display: none !important
}

.search-bar {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 12
}

.search-bar.show {
  display: block
}

.search-bar .search-form {
  margin: 56px 120px;
  display: flex;
  align-items: center
}

.search-bar .search-form .input__group {
  border-radius: 0 8px 8px 0;
  position: relative;
  height: fit-content
}

.search-bar .search-form .input-group-append,
.search-bar .search-form .input-group-prepend {
  position: relative
}

.search-bar .search-form .form__control {
  background-color: #f8f7f7;
  border-color: #f8f7f7
}

.search-bar .search-form .form__control:focus {
  color: none;
  background-color: none;
  border-color: #f8f7f7;
  outline: 0;
  -webkit-box-shadow: none;
  box-shadow: none
}

.search-bar .search-form .search-category-dropdown {
  border-radius: 0;
  width: 280px;
  background-color: #f8f7f7;
  color: #1f0300;
  justify-content: flex-end
}

.search-bar .search-form .search-category-dropdown:hover {
  color: #fff
}

.search-bar .search-form .search-separator {
  position: absolute;
  left: 0;
  top: 0;
  background-color: #9a8e8c;
  width: 1px;
  height: 100%;
  z-index: 9
}

.search-bar .search-form .dropdown-menu {
  position: absolute;
  top: calc(100% + 10px);
  left: 60px !important;
  z-index: 1000;
  min-width: 70%
}

.search-bar .search-form .search-icn {
  border-radius: 0;
  border-radius: 0 8px 8px 0;
  background-color: var(--primary);
  border-color: var(--primary);
  padding: 8px 24px
}

@media (max-width:991.97px) {
  .search-bar .search-form {
    margin: 40px 80px
  }

  .search-bar .search-form .search-category-dropdown {
    width: 160px
  }
}

@media (max-width:767.98px) {
  .search-bar .search-form {
    margin: 30px 20px
  }

  .search-bar .search-form .form__control {
    height: 44px
  }

  .search-bar .search-form .search-category-dropdown {
    width: 120px;
    height: 44px;
    padding: 10px;
    font-size: 12px
  }

  .search-bar .search-form .search-icn {
    width: 60px;
    height: 44px
  }
}

@media (max-width:575.97px) {
  .search-bar .search-form {
    margin: 30px 20px
  }

  .search-bar .search-form .search-separator {
    height: 100%
  }
}

