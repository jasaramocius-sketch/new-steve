  background-color: var(--hov-primary);
  color: #fff
}

.compare-table th {
  background: #f8f9fa;
  font-weight: 600;
  vertical-align: middle
}

.compare-table td {
  background: #fff;
  padding: 25px
}

.compare-table img {
  transition: .3s
}

.compare-table img:hover {
  transform: scale(1.05)
}

.compare-page-products {
  padding: 50px 0 !important
}

.compare-table-wrapper {
  overflow-x: auto
}

.compare-table {
  min-width: 1200px
}

.compare-table td:first-child,
.compare-table th:first-child {
  position: sticky;
  left: 0;
  background: #f8f9fa;
  z-index: 2;
  min-width: 180px
}

.compare-table th:first-child {
  background: #eef0f4
}

.compare-table th {
  position: sticky;
  top: 0;
  background: #fff;
  z-index: 3
}

.compare-table th:first-child {
  z-index: 4
}

.compare-page-products .btn.btn-outline-secondary.btn-sm {
  background-color: var(--primary);
  color: #fff;
  border: none
}

.compare-col a {
  color: #000 !important;
  font-size: 20px;
  font-weight: 600
}

.compare-col a:hover {
  color: var(--primary) !important
}

.blog-card {
  transition: .3s
}

.blog-card:hover {
  transform: translateY(-5px)
}

.blog-image {
  overflow: hidden
}

.blog-image img {
  height: 420px;
  object-fit: cover;
  transition: .5s
}

.blog-card:hover img {
  transform: scale(1.05)
}

.blog-title a {
  color: #111;
  text-decoration: none
}

.blog-title a:hover {
  color: #e63946
}

.blog-meta {
  color: #777;
  font-size: 14px
}

