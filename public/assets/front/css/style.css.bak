.page-content {
  display: flex;
  flex-direction: column;
  gap: 24px
}

.page-content__header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 16px
}

.page-content__title {
  font-size: 1.5rem;
  font-weight: 600;
  color: #1f0300;
  margin: 0
}

.table--custom {
  min-width: max-content;
  border-collapse: separate;
  border-spacing: 0
}

.table--custom thead tr th {
  font-size: .875rem;
  font-weight: 600;
  line-height: 150%;
  padding: 16px 12px;
  text-align: center;
  vertical-align: middle;
  color: #1f0300;
  border-color: #e8e5e3;
  background-color: #f8f6f5
}

.table--custom thead tr th:first-child {
  text-align: left;
  padding-left: 24px
}

.table--custom thead tr th:last-child {
  text-align: right;
  padding-right: 24px
}

.table--custom tbody tr td {
  font-size: .875rem;
  font-weight: 500;
  line-height: 120%;
  padding: 12px;
  text-align: center;
  vertical-align: middle;
  color: rgba(31, 3, 0, .8);
  border-color: #e8e5e3;
  background-color: #fff
}

.table--custom tbody tr td:first-child {
  text-align: left;
  padding-left: 24px
}

.table--custom tbody tr td:last-child {
  text-align: right;
  padding-right: 24px
}

.table--custom tbody tr:not(:last-child) td {
  border-color: #e8e5e3;
  display: table-cell
}

@media (max-width:1199px) {
  .table--custom.table--responsive-lg {
    display: block;
    width: 100%;
    min-width: unset
  }

  .table--custom.table--responsive-lg thead {
    display: none
  }

  .table--custom.table--responsive-lg tbody {
    display: block
  }

  .table--custom.table--responsive-lg tbody tr {
    display: block;
    border: 1px solid #e8e5e3;
    border-radius: 8px;
    margin-bottom: 12px
  }

  .table--custom.table--responsive-lg tbody tr td {
    text-align: right;
    padding: 10px 16px !important;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
    border: none;
    border-bottom: 1px solid #e8e5e3;
    width: auto !important;
    background-color: transparent !important
  }

  .table--custom.table--responsive-lg tbody tr td::before {
    content: attr(data-label);
    font-size: .875rem;
    font-weight: 600;
    line-height: 120%;
    color: #1f0300;
    text-align: left;
    white-space: nowrap
  }

  .table--custom.table--responsive-lg tbody tr td:last-child {
    border-bottom: none
  }

  .table--custom.table--responsive-lg tbody tr td .action-buttons {
    justify-content: flex-end
  }
}

@media (max-width:576px) {
  .table--custom.table--responsive-lg tbody tr td .action-buttons {
    gap: 4px
  }

  .table--custom.table--responsive-lg tbody tr td .action-buttons .action-btn {
    --size: 32px
  }

  .table--custom.table--responsive-lg tbody tr td .action-buttons .action-btn svg {
    width: 14px;
    height: 14px
  }
}

.badge {
  font-size: .75rem;
  font-weight: 500;
  line-height: 100%;
  padding: 6px 12px;
  border-radius: 8px;
  text-align: center;
  display: inline-block
}

.bg-danger {
  background-color: var(--primary) !important
}

.badge--base {
  color: #e62e04;
  background-color: rgba(230, 46, 4, .15)
}

.badge--success {
  color: #85b567;
  background-color: rgba(133, 181, 103, .15)
}

.badge--danger {
  color: #e62e04;
  background-color: rgba(230, 46, 4, .15)
}

.badge--warning {
  color: #f3af3d;
  background-color: rgba(243, 175, 61, .15)
}

.badge--primary {
  color: #3490f3;
  background-color: rgba(52, 144, 243, .15)
}

.badge--info {
  color: #3490f3;
  background-color: rgba(52, 144, 243, .15)
}

.badge--secondary {
  color: #8d8d8d;
  background-color: rgba(141, 141, 141, .15)
}

.badge-outline--base {
  color: #1f0300;
  border: 1px solid rgba(230, 46, 4, .5);
  background-color: rgba(230, 46, 4, .15)
}

.badge-dotted--base {
  color: #e62e04;
  display: inline-flex;
  align-items: center;
  gap: 6px
}

.badge-dotted--base::before {
  content: "";
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: #e62e04
}

.action-buttons {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px
}

.action-buttons .action-btn,
.address-action-menu .action-btn,
.nav-menu-editor .action-btn {
  --size: 36px;
  width: var(--size);
  height: var(--size);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  padding: 0;
  font-size: 0;
  transition: .2s ease;
  cursor: pointer
}

.action-buttons .action-btn.btn-cancel,
.address-action-menu .action-btn.btn-cancel {
  color: #e62e04;
  border: 1px solid rgba(230, 46, 4, .2);
  background: rgba(230, 46, 4, .08)
}

.action-buttons .action-btn.btn-cancel:hover,
.address-action-menu .action-btn.btn-cancel:hover {
  color: #fff;
  background: #e62e04
}

.action-buttons .action-btn.btn-view,
.address-action-menu .action-btn.btn-view {
  color: #1f0300;
  border: 1px solid rgba(31, 3, 0, .15);
  background: rgba(31, 3, 0, .05)
}

.action-buttons .action-btn.btn-view:hover,
.address-action-menu .action-btn.btn-view:hover {
  color: #fff;
  background: #1f0300
}

.action-buttons .action-btn.btn-invoice,
.address-action-menu .action-btn.btn-invoice {
  color: #3490f3;
  border: 1px solid rgba(52, 144, 243, .2);
  background: rgba(52, 144, 243, .08)
}

.action-buttons .action-btn svg:hover,
.address-action-menu .action-btn.btn-invoice:hover {
  color: #fff !important
}

.action-buttons .action-btn.btn-invoice:hover,
.address-action-menu .action-btn.btn-invoice:hover {
  color: #fff;
  background: #3490f3
}

.action-buttons .action-btn svg,
.address-action-menu .action-btn svg {
  width: 16px;
  height: 16px
}

.action-buttons .action-btn.btn-edit,
.address-action-menu .action-btn.btn-edit {
  color: #e67a38;
  border: 1px solid rgba(230, 122, 56, .2);
  background: rgba(230, 122, 56, .08)
}

.action-buttons .action-btn.btn-edit:hover,
.address-action-menu .action-btn.btn-edit:hover {
  color: #fff;
  background: #e67a38
}

.action-buttons .action-btn.btn-view-live,
.address-action-menu .action-btn.btn-view-live {
  color: #198754;
  border: 1px solid rgba(25, 135, 84, .2);
  background: rgba(25, 135, 84, .08)
}

.action-buttons .action-btn.btn-view-live:hover,
.address-action-menu .action-btn.btn-view-live:hover {
  color: #fff;
  background: #198754
}

.action-buttons .action-btn.btn-view-history,
.address-action-menu .action-btn.btn-view-history {
  color: #0d6efd;
  border: 1px solid rgba(13, 110, 253, .2);
  background: rgba(13, 110, 253, .08)
}

.action-buttons .action-btn.btn-view-history:hover,
.address-action-menu .action-btn.btn-view-history:hover {
  color: #fff;
  background: #0d6efd
}

.action-buttons .action-btn.btn-restore,
.address-action-menu .action-btn.btn-restore {
  color: #198754;
  border: 1px solid rgba(25, 135, 84, .2);
  background: rgba(25, 135, 84, .08)
}

.action-buttons .action-btn.btn-restore:hover,
.address-action-menu .action-btn.btn-restore:hover {
  color: #fff;
  background: #198754
}

.action-buttons .action-btn.btn-set-default,
.address-action-menu .action-btn.btn-set-default {
  color: #3490f3;
  border: 1px solid rgba(52, 144, 243, .2);
  background: rgba(52, 144, 243, .08)
}

.action-buttons .action-btn.btn-set-default:hover,
.address-action-menu .action-btn.btn-set-default:hover {
  color: #fff;
  background: #3490f3
}

.action-btn {
  --size: 36px;
  width: var(--size);
  height: var(--size);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  padding: 0;
  font-size: 0;
  transition: .2s ease;
  cursor: pointer
}

.action-btn svg {
  width: 16px;
  height: 16px
}

.action-btn.btn-cancel {
  color: #e62e04;
  border: 1px solid rgba(230, 46, 4, .2);
  background: rgba(230, 46, 4, .08)
}

.action-btn.btn-cancel:hover {
  color: #fff;
  background: #e62e04
}

.pagination-wrapper {
  margin-top: 8px
}

.pagination-wrapper nav>* {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12px
}

.pagination-wrapper p {
  font-size: .875rem;
  color: rgba(31, 3, 0, .6);
  margin: 0
}

.empty-section {
  text-align: center;
  padding: 60px 20px
}

.empty-section .empty-icon {
  width: 80px;
  height: 80px;
  margin: 0 auto 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f8f6f5
}

.empty-section .empty-icon svg {
  width: 36px;
  height: 36px;
  stroke: #bbb
}

.empty-section h5 {
  color: #1f0300;
  margin-bottom: 8px
}

.empty-section p {
  color: rgba(31, 3, 0, .6);
  margin-bottom: 20px
}

.dashboard-body {
  width: 100%
}

.order-item {
  display: flex;
  align-items: center;
  gap: 12px
}

.order-item__thumb {
  width: 40px;
  height: 40px;
  flex-shrink: 0;
  border-radius: 6px;
  overflow: hidden
}

.order-item__thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover
}

.order-item__content {
  flex: 1;
  min-width: 0
}

.order-item__title {
  margin-bottom: 0;
  font-size: .875rem;
  font-weight: 600;
  color: #1f0300;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap
}

.table tr td:not(:has(.btn))>a {
  text-decoration: underline;
  color: rgba(31, 3, 0, .75);
  font-weight: 600
}

.dashboard-topbar {
  display: flex;
  flex-wrap: wrap-reverse;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 24px
}

.dashboard-filter {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  margin-bottom: 24px
}

.dashboard-filter__link {
  font-size: .875rem;
  font-weight: 500;
  border-radius: 8px;
  color: #1f0300;
  background-color: #fff;
  border: 1px solid #e8e5e3;
  padding: 6px 16px;
  white-space: nowrap;
  transition: .3s ease;
  text-decoration: none
}

.dashboard-filter__link.active,
.dashboard-filter__link:hover {
  color: #fff;
  background-color: #e62e04;
  border-color: #e62e04
}

.btn--base {
  color: #fff;
  border-color: #e62e04;
  background-color: #e62e04;
  border-radius: 9999px
}

.btn--base:hover {
  color: #fff !important;
  border-color: #cf2a05 !important;
  background-color: #cf2a05 !important
}

.btn--sm {
  font-size: .875rem;
  padding: 12px 18px
}

.page-short-description {
  font-size: .88rem;
  color: #64748b
}

.policies-page-wrapper {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  color: var(--policies-page-text);
  background-color: var(--policies-page-light-bg);
  line-height: 1.7
}

.policies-page-container {
  margin: 0 auto;
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 2.5rem;
  align-items: start
}

.policies-page-sidebar {
  background: #fff;
  border: 1px solid var(--policies-page-border);
  border-radius: var(--policies-page-radius);
  box-shadow: var(--policies-page-shadow);
  position: sticky;
  top: 4.5rem
}

.policies-page-sidebar-title {
  font-size: .85rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: #64748b;
  margin-bottom: 1rem;
  padding-bottom: .5rem;
  border-bottom: 1px solid var(--policies-page-border)
}

.policies-page-nav-list {
  list-style: none;
  margin: 0;
  padding: 0
}

.policies-page-nav-item {
  margin-bottom: .4rem
}

.policies-page-nav-link {
  display: flex;
  align-items: center;
  padding: .8rem 1rem;
  color: var(--policies-page-text);
  text-decoration: none;
  font-weight: 600;
  font-size: .95rem;
  border-radius: 6px;
  transition: all .2s ease-in-out
}

.policies-page-nav-link:hover {
  background-color: #fff1f1;
  color: var(--policies-page-primary)
}

.policies-page-nav-link.active {
  background-color: #fef2f2;
  color: var(--policies-page-primary);
  border-left: 4px solid var(--policies-page-primary);
  border-top-left-radius: 0;
  border-bottom-left-radius: 0
}

.policies-page-content-card {
  background: #fff;
  border: 1px solid var(--policies-page-border);
  border-radius: var(--policies-page-radius);
  box-shadow: var(--policies-page-shadow)
}

.policies-page-title-banner {
  border-bottom: 2px solid var(--policies-page-border);
  padding-bottom: 1.5rem;
  margin-bottom: 2rem
}

.policies-page-main-title {
  font-size: 2.2rem;
  font-weight: 800;
  color: var(--policies-page-heading);
  letter-spacing: -.5px;
  margin-bottom: .5rem
}

.policies-page-section {
  margin-bottom: 2.5rem
}

.policies-page-section-title {
  font-size: 1.35rem;
  font-weight: 700;
  color: var(--policies-page-heading);
  margin-bottom: 1rem;
  display: flex;
  align-items: center;
  gap: .5rem
}

.policies-page-text-block {
  margin-bottom: 1.25rem;
  font-size: 1rem;
  color: #475569
}

.policies-page-list {
  padding-left: 1.5rem;
  margin-bottom: 1.5rem;
  color: #475569
}

.policies-page-list li {
  margin-bottom: .6rem
}

.policies-page-table-wrapper {
  overflow-x: auto;
  margin: 1.5rem 0;
  border: 1px solid var(--policies-page-border)
}

.policies-page-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  font-size: .95rem
}

.policies-page-table th {
  background-color: #f8fafc;
  color: var(--policies-page-heading);
  font-weight: 700;
  padding: .85rem 1.2rem;
  border-bottom: 1px solid var(--policies-page-border)
}

.policies-page-table td {
  padding: .85rem 1.2rem;
  border-bottom: 1px solid var(--policies-page-border);
  color: #475569
}

.policies-page-table tr:last-child td {
  border-bottom: none
}

.policies-page-alert-box {
  background-color: #fef2f2;
  border-left: 4px solid var(--policies-page-primary);
  border-radius: 0 8px 8px 0;
  padding: 1.25rem 1.5rem;
  margin: 1.5rem 0
}

.policies-page-alert-title {
  font-weight: 700;
  color: var(--policies-page-primary);
  margin-bottom: .3rem;
  font-size: 1rem
}

@media (max-width:900px) {
  .policies-page-container {
    grid-template-columns: 1fr
  }

  .policies-page-sidebar {
    position: static
  }

  .policies-page-nav-list {
    display: flex;
    overflow-x: auto;
    gap: .5rem
  }

  .policies-page-nav-link {
    white-space: nowrap
  }
}

.page-title-banner::before {
  content: "";
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, .5);
  z-index: 1
}

.page-title-banner>* {
  position: relative;
  z-index: 2
}

.page-title-banner {
  position: relative
}

.st-policy-wrapper {
  color: #d1d5db;
  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  line-height: 1.6;
  padding: 2.5rem 1rem
}

.st-policy-container {
  max-width: 80rem;
  margin: 0 auto
}

.st-policy-wrapper aside {
  display: none
}

.st-policy-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2rem
}

.st-policy-sidebar-card {
  position: sticky;
  top: 5.5rem;
  background-color: #030712;
  border: 1px solid #1f2937;
  border-radius: .75rem;
  padding: 1rem;
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, .5)
}

.st-policy-sidebar-title {
  font-size: .75rem;
  font-weight: 600;
  color: #6b7280;
  text-transform: uppercase;
  letter-spacing: .05em;
  padding-left: .75rem;
  padding-bottom: .75rem;
  margin: 0
}

.policies-page-nav-list {
  list-style: none;
  padding: 0;
  margin: 0
}

.policies-page-nav-item {
  margin-bottom: .25rem
}

.policies-page-nav-link {
  display: flex;
  align-items: center;
  gap: .75rem;
  padding: .625rem .75rem;
  border-radius: .5rem;
  font-size: .875rem;
  font-weight: 500;
  text-decoration: none;
  color: #9ca3af;
  transition: all .2s ease-in-out
}

.policies-page-nav-link:hover {
  background-color: var(--primary);
  color: #fff
}

.policies-page-nav-link.active {
  color: #fff;
  background-color: rgba(220, 38, 38, .1);
  border-left: 4px solid #dc2626
}

.st-policy-nav-icon {
  width: 1.25rem;
  text-align: center
}

.st-policy-content-card {
  background-color: #030712;
  border: 1px solid #1f2937;
  border-radius: .5rem;
  padding: 1.5rem
}

@media (min-width:640px) {
  .st-policy-content-card {
    padding: 2rem
  }
}

.st-policy-header {
  display: flex;
  align-items: center;
  gap: .75rem;
  border-bottom: 1px solid #1f2937;
  padding-bottom: 1rem;
  margin-bottom: 1.5rem
}

.st-policy-header-icon {
  color: #ef4444;
  font-size: 1.5rem
}

.st-policy-main-title {
  font-size: 1.5rem;
  font-weight: 700;
  color: #fff;
  margin: 0
}

.st-policy-sub-title {
  font-size: .75rem;
  color: #6b7280;
  margin: 0
}

.st-policy-section-title {
  font-size: 1rem;
  font-weight: 600;
  color: #fff;
  margin-top: 1.25rem;
  margin-bottom: .5rem
}

.st-policy-text-block {
  font-size: .875rem;
  color: #d1d5db;
  margin-bottom: 1rem
}

.st-policy-list {
  list-style-type: disc;
  padding-left: 1.25rem;
  color: #9ca3af;
  font-size: .875rem;
  margin-bottom: 1rem
}

.st-policy-list-ordered {
  list-style-type: decimal;
  padding-left: 1.25rem;
  color: #9ca3af;
  font-size: .875rem;
  margin-bottom: 1rem
}

.st-policy-list-item {
  margin-bottom: .375rem
}

.st-policy-highlight-box {
  background-color: #111827;
  border: 1px solid #1f2937;
  border-radius: .5rem;
  padding: 1rem;
  margin-top: 1rem;
  margin-bottom: 1rem
}

.st-policy-box-title {
  font-size: .75rem;
  font-weight: 600;
  color: #ef4444;
  text-transform: uppercase;
  margin: 0 0 .5rem 0
}

.st-policy-grid-cards {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1rem;
  margin-top: 1rem
}

@media (min-width:640px) {
  .st-policy-grid-cards {
    grid-template-columns: 1fr 1fr
  }
}

.st-policy-contact-card {
  background-color: #111827;
  border: 1px solid #1f2937;
  border-radius: .5rem;
  padding: 1rem
}

.st-policy-mono-email {
  color: #ef4444;
  font-family: monospace
}

.address-modal .btn-close.steve-btn,
.modal-header .btn-close,
.review-page-vr-modal .btn-close.steve-btn {
  background-color: red;
  opacity: 1;
  color: #fff !important;
  filter: none;
  min-height: 15px;
  --bs-btn-close-bg: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='%23fff'%3e%3cpath d='M.293.293a1 1 0 0 1 1.414 0L8 6.586 14.293.293a1 1 0 1 1 1.414 1.414L9.414 8l6.293 6.293a1 1 0 0 1-1.414 1.414L8 9.414l-6.293 6.293a1 1 0 0 1-1.414-1.414L6.586 8 .293 1.707a1 1 0 0 1 0-1.414z'/%3e%3c/svg%3e")
}

@media (max-width:576px) {
  .user-followed-seller-actions {
    flex-direction: column
  }
}
.steve-btn.swiper-button-disabled i{
background-color: transparent;  
color: var(--primary); 
cursor: text;
}
.steve-btn.swiper-button-disabled i:hover{
  background-color: transparent; 
  color: var(--primary); 
}
.swiper-slide .single-product .product-title {
  display: -webkit-box;
  -webkit-line-clamp: 1;
  line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.swiper-slide .single-product .ratings-wrapper svg path {
  fill: #9a909045;
}
/* Summary tables: pehli row ke upar hairline (order-confirmed, checkout payment) */
table.summary-table tbody tr:first-child > th,
table.summary-table tbody tr:first-child > td,
table.summary-table thead tr:first-child > th {
  border-top: 1px solid #e6e8ec
}
td.admin-product-name a {
    display: block;
    max-width: 30ch;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}