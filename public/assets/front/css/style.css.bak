  .search-bar .search-form {
    margin: 30px 10px
  }

  .search-bar .search-form .search-category-dropdown {
    font-size: 12px;
    width: 120px
  }

  .search-bar .search-form .search-icn {
    width: 60px;
    height: 44px
  }

  .search-bar .search-form .search-separator {
    height: 100%
  }
}

.search-suggestions {
  display: none;
  position: absolute;
  top: 100%;
  left: 0;
  width: 100%;
  background: #fff;
  border: 1px solid #e0e0e0;
  border-radius: 0 0 8px 8px !important;
  box-shadow: 0 8px 24px rgba(0, 0, 0, .15);
  z-index: 9999;
  max-height: 400px;
  overflow-y: auto
}

.search-suggestions.active {
  display: block
}

.search-suggestion-item {
  display: flex;
  align-items: center;
  padding: 10px 16px;
  cursor: pointer;
  text-decoration: none;
  color: #333;
  border-bottom: 1px solid #f0f0f0;
  transition: background-color .15s
}

.search-suggestion-item:last-child {
  border-bottom: none
}

.search-suggestion-item:hover {
  background-color: #f8f7f7
}

.search-suggestion-item img {
  width: 50px;
  height: 50px;
  object-fit: cover;
  border-radius: 6px;
  margin-right: 12px;
  flex-shrink: 0
}

.search-suggestion-info {
  flex: 1;
  min-width: 0
}

.search-suggestion-name {
  font-size: 14px;
  font-weight: 500;
  color: #1f0300;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 2px
}

.search-suggestion-meta {
  font-size: 12px;
  color: #888
}

.search-suggestion-price {
  font-size: 14px;
  font-weight: 600;
  color: var(--primary);
  margin-left: 12px;
  flex-shrink: 0
}

.search-suggestion-no-results {
  padding: 16px;
  text-align: center;
  color: #888;
  font-size: 14px
}

.search-suggestions .search-suggestion-loading {
  padding: 16px;
  text-align: center;
  color: #888;
  font-size: 14px
}

@media (max-width:767.98px) {
  .search-suggestion-item img {
    width: 40px;
    height: 40px
  }

  .search-suggestion-name {
    font-size: 13px
  }
}

.overlay {
  position: fixed;
  top: 0;
  left: 0;
  display: block;
  width: 100%;
  height: 100%;
  z-index: 10;
  background-color: rgb(3 7 18 / 84%);
  -webkit-transition: all .3s ease-in;
  -o-transition: all .3s ease-in;
  transition: all .3s ease-in;
  opacity: 0;
  visibility: hidden
}

.overlay.active {
  opacity: 1;
  visibility: visible
}

.icon-circle .icon-circle-cart-count,
.icon-circle .icon-circle-compare-count,
.icon-circle .icon-circle-wishlist-count {
