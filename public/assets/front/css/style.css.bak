  font-size: 20px;
  font-weight: 600;
  margin-bottom: 10px
}

.category-card {
  background: #fff;
  border: 1px solid #eee;
  overflow: hidden;
  transition: .3s;
  height: 100%;
  border-radius: 0
}

.category-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 10px rgba(0, 0, 0, .08)
}

.category-card:hover .category-content a.text-dark {
  color: var(--primary) !important;
}

.category-image {
  background: #fff;
