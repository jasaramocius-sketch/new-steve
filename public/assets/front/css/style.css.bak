  justify-content: center;
  align-items: center;
  text-align: center;
  height: 300px;
  width: 300px;
}
.gs-cate-section .category-image {
  height: auto;
  width: 100%;
  max-width: 300px;
  aspect-ratio: 1/1;
  margin-bottom:20px;
}

.gs-cate-section .category-image picture {
  background: #fff;
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
  height: 100%;
  width: 100%
}

.gs-cate-section .category-image img {
  width: 100%;
  height: 100%;
  object-fit: cover
}
.category-content h5 {
  font-weight: 700;
  margin-bottom: 10px
}

.category-content h5 a {
  color: #222;
  text-decoration: none
}

.category-content h5 a:hover {
  color: var(--primary)
}

.sub-cat-list {
  padding-left: 18px;
  min-height: 110px;
  list-style: none;
  padding: 0;
  margin: 15px 0 0
}

.sub-cat-list li {
  margin-bottom: 8px;
  position: relative;
  padding: 8px 25px 8px 0;
  border-bottom: 1px solid #f1f1f1
}

.sub-cat-list li::after {
  content: "\f105";
  font-family: "Font Awesome 6 Free";
  font-weight: 900;
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  color: #ff3c00;
  transition: .3s
}

.sub-cat-list li:last-child {
  border-bottom: none
}

.sub-cat-list a {
  text-decoration: none;
  color: #222;
  display: block;
  transition: .3s
}

.sub-cat-list li a:hover {
  color: #ff3c00
}

.row.g-4.categories-page .category-image img {
  width: 100%;
  object-fit: cover
}

.category-card:hover {
  box-shadow: 0 10px 30px rgba(0, 0, 0, .08);
  transform: translateY(-5px)
}

.categories-page .img-fluid {
  height: 65vh;
  width: 100%;
  object-fit: cover
}

.category-title {
  font-size: 20px;
  font-weight: 600;
  margin: 15px 0
}

.category-list-card {
  display: flex;
  align-items: flex-start;
  gap: 25px;
  background: #fff;
  border: 1px solid #eee;
  border-radius: 12px;
  padding: 25px;
  margin-bottom: 20px;
  transition: .3s
}

.category-list-card:hover {
  box-shadow: 0 10px 30px rgba(0, 0, 0, .08)
}

.category-list-card img {
  width: 90px;
  height: 90px;
  object-fit: contain
}

.category-list-content {
  flex: 1
}

.category-toolbar .toolbar-right .view-btn {
  border: 1px solid var(--primary)
}

.toolbar-right {
  display: flex;
  justify-content: flex-end;
  align-items: center
}

.sort-select {
  width: 180px
}

.view-btn {
  width: 42px;
  border: 1px solid var(--primary);
  background: #fff;
  color: var(--primary);
  padding: 8px
}

.view-btn.active:hover,
.view-btn:hover {
  background: var(--hov-primary) !important;
  border-color: var(--hov-primary) !important;
  color: #fff !important
}

.view-btn.active {
  background: var(--primary) !important;
  border-color: var(--primary) !important;
  color: #fff !important
}

@media (hover:none) {
  .view-btn:hover {
    background: #fff !important;
    border-color: var(--primary) !important;
    color: var(--primary) !important
  }
}

.category-image a {
  height: 100%;
  width: 100%;
  max-width: 100%;
  display: flex;
  justify-content: center;
  align-items: center
}

.category-image a picture {
  width: 100%;
  height: 100%
}

.category-image img {
  width: 100%;
  height: 100%;
  object-fit: cover
}

.category-content {
