body,
html {
  min-height: 100%
}

html {
  scroll-padding-top: 120px
}

:root {
  --blue: #3490f3;
  --gray: #9d9da6;
  --gray-dark: #8d8d8d;
  --secondary: #2d4776;
  --soft-secondary: rgba(145, 145, 153, 0.15);
  --success: #85b567;
  --soft-success: rgba(133, 181, 103, 0.15);
  --warning: #f3af3d;
  --soft-warning: rgba(243, 175, 61, 0.15);
  --light: #f5f5f5;
  --soft-light: #dfdfe6;
  --soft-white: #b5b5bf;
  --dark: #292933;
  --soft-dark: #1b1b28;
  --primary: #d02a03;
  --hov-primary: #af2405;
  --soft-primary: rgba(230, 46, 4, 0.15);
  --secondary-bg-color: #f6f6f6;
  --forest-green: #2e8b57;
  --dark-slate: #1a1a1a;
  --light-grey: #f8f9fa;
  --text-muted: #666666;
  --transition-speed: 0.3s ease;
  --green: #85b567
}

body {
  margin: 0;
  font-family: Poppins, sans-serif;
  overflow-x: hidden;
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 100vh
}

main {
  flex: 1 0 auto
}

footer {
  margin-top: auto
}

input {
  outline: 0
}

select {
  outline: 0;
  border: 0
}

a {
  text-decoration: none;
  -webkit-transition: all .3s;
  -o-transition: all .3s;
  transition: all .3s;
  color: var(--primary);
  text-decoration: none !important
}

.text-primary[href] {
  color: var(--primary) !important
}

ul {
  list-style-type: none;
  padding: 0;
  margin-bottom: 0
}

button {
  border: 0;
  background-color: transparent;
  font-family: Poppins, sans-serif;
  font-size: 16px;
  padding: 12px 24px;
  line-height: 1.2;
  border-radius: 8px;
  cursor: pointer;
  -webkit-transition: all .3s ease-in;
  -o-transition: all .3s ease-in;
  transition: all .3s ease-in
}

.button-hover:hover {
  background-color: var(--hov-primary);
  color: #fff
}

.a-tag-text-hover:hover {
  color: var(--hov-primary) !important
}

.primary-a-tag-text-hover:hover {
  color: var(--primary) !important;
  transition: color .3s ease
}

.btn-outline-secondary {
  border: 1px solid var(--secondary) !important;
  color: var(--secondary) !important
}

.btn-group-sm>.btn,
.btn-sm {
  --bs-btn-font-size: 12px
}

@media (max-width:767.98px) {

  .admin-dashboard-header .steve-btn,
  .admin-product-index-search-form .steve-btn {
    padding: 10px 16px !important;
    font-size: 13px !important
  }

  .admin-product-index-search-form {
    width: 100%
  }

  .single-product .compare,
  .single-product .details,
  .single-product-list-view .compare,
  .single-product-list-view .details {
    padding: 10px 14px !important
  }
}

@media (max-width:1212px) {
  .revenue-chart-navbar {
    flex-direction: column;
    gap: 5px;
    align-items: flex-start !important
  }
}

.shadow-sm {
  box-shadow: 0 .125rem 6rem rgba(0, 0, 0, .075) !important
}

.front-header-search {
  display: none
}

.text-success {
  border-bottom-color: var(--green) !important;
  color: var(--green) !important
}

.steve-btn {
  min-height: 40px;
  display: flex;
  align-items: center;
  justify-content: center
}
.featured-status-btn .steve-btn {
    min-height: auto;
}
button#searchIcon {
  min-width: 40px;
  min-height: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  background-color: transparent
}
.right-0 {
  right: 0 !important
}
button#searchIcon:hover {
  background-color: #0000
}

button#searchIcon svg:hover path {
  stroke: var(--primary)
}

.add-cart button,
.add-to-cart button,
.single-product .add-cart,
.single-product-list-view .add-cart,
button.add-cart,
button.add-to-cart {
  font-family: inherit;
  font-size: inherit;
  padding: 12px;
  line-height: inherit;
  border-radius: 8px
}

.single-blog-content-navigation a {
  color: var(--primary)
}

.btn-outline-primary {
  color: var(--primary);
  border-color: var(--primary)
}

.a-tag-hover-color:hover {
  color: var(--secondary) !important
}

.a-tag-hover-color-red:hover {
  color: var(--primary) !important
}

.a-tag-hover-color {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  text-decoration: none;
  transition: color .3s ease
}

.a-tag-hover-color i,
.blog-page-cat-list i {
  transition: transform .3s ease
}

.gs-brands-section .a-tag-hover-color:hover i {
  color: var(--secondary)
}

.a-tag-hover-color:hover i,
.blog-page-cat-list:hover i {
  transform: translateX(6px);
  color: var(--primary)
}

.single-blog-content-navigation a:hover {
  color: var(--secondary)
}

.a-tag-hover-color:hover i.fas.fa-arrow-left {
  transform: translateX(-6px)
}

.a-tag-hover-color i.fas.fa-arrow-left,
.a-tag-hover-color i.fas.fa-arrow-right {
  color: var(--primary)
}

.a-tag-hover-color:hover i.fas.fa-arrow-left,
.a-tag-hover-color:hover i.fas.fa-arrow-right {
  color: var(--secondary)
}

.steve-btn-hover:hover {
  background-color: var(--hov-primary) !important
}

.blog-page-cat-list {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  transition: color .3s ease
}

@media (max-width:1399px) {
  .shop_details_sidebar {
    display: grid;
    gap: 20px;
    grid-template-columns: 1fr 1fr;
    padding-top: 20px;
  }

  .shop_details_sidebar_info {
    margin-bottom: 0 !important
  }
}

@media (max-width:1023px) {

  .container,
  .container-md,
  .container-sm {
    max-width: 960px
  }
}

@media (max-width:576px) {
  .section-with-padding {
    padding: 0 20px
  }

  .shop_details_sidebar {
    grid-template-columns: 1fr
  }
}

h1,
h2 {
  font-weight: 700;
  font-family: Saira, sans-serif;
  padding: 0;
  margin: 0
}

h3,
h4,
h5,
h6 {
  font-weight: 600;
  font-family: Saira, sans-serif;
  padding: 0;
  margin: 0
}

h1 {
  font-size: 54px
}

@media (max-width:1199.97px) {
  h1 {
    font-size: 32px
  }
}

@media (max-width:767.98px) {
  h1 {
    font-size: 24px
  }
}

h2 {
  font-size: 36px
}

@media (max-width:1199.97px) {
  h2 {
    font-size: 28px
  }
}

h3 {
  font-size: 40px;
}

@media (max-width:1199.97px) {
  h3 {
    font-size: 28px
  }
}

h4 {
  font-size: 32px
}

@media (max-width:1199.97px) {
  h4 {
    font-size: 24px
  }
}

h5 {
  font-size: 18px
}

@media (max-width:1199.97px) {
