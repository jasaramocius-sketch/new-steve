.dropdown-toggle::after {
  margin-left: .255em;
  border-top: .4em solid;
  border-right: .4em solid transparent;
  border-bottom: 0;
  border-left: .4em solid transparent;
  border-radius: 2px
}

.dropdown-toggle::after {
  transition: transform .3s ease
}

.dropdown-toggle+.dropdown-menu.show {
  display: block
}

