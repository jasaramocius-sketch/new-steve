  box-shadow: unset
}

.form-select-wrapper {
  position: relative;
  display: block
}

tfoot tr:first-child,
thead tr:first-child {
  border-top: 1px solid #e6e8ec
}

tbody tr:last-child {
  border-bottom: 1px solid #e6e8ec
}

.form-select {
  background-image: none;
  padding-right: 2.25rem
}

.form-select-wrapper::after {
  content: '';
  position: absolute;
  right: .75rem;
  top: 50%;
  width: 16px;
  height: 16px;
  background: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23343a40' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m2 5 6 6 6-6'/%3e%3c/svg%3e") no-repeat center/contain;
  transform: translateY(-50%) rotate(0);
  transition: transform .2s ease;
  pointer-events: none
}

.select-dropdown-icon .form-select-wrapper::after {
  background: unset
}

.form-select-wrapper.focused::after {
  transform: translateY(-50%) rotate(180deg)
