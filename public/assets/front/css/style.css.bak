  }
}

h6 {
  font-size: 20px
}

@media (max-width:1199.97px) {
  h6 {
    font-size: 18px
  }
}

@media (max-width:767.98px) {
  h6 {
    font-size: 16px
  }
}

p {
  margin: 0;
  padding: 0;
  font-size: 16px;
  line-height: 170%;
  font-weight: 400;
  font-family: Poppins, sans-serif
}

@media (max-width:1199.97px) {
  p {
    font-size: 14px
  }
}

p.text-xs {
  font-size: 12px
}

p.text-lg {
  font-size: 18px
}

@media (max-width:1199.97px) {
  p.text-lg {
    font-size: 16px
  }
}
.w-10{
    width:12%;
}
.w-80 {
  width: 80% !important
}
.w-84{
  width: 84%;
}
.w-60 {
  width: 60% !important
}

.w-40 {
  width: 40% !important
}

#toast-container>.toast-success {
  background-color: #28a745
}

#toast-container>.toast-error {
  background-color: #e62e04
}

#toast-container>.toast-info {
  background-color: #17a2b8
}

#toast-container>.toast-warning {
  background-color: #ffc107;
  color: #333
}

.address-actions-dropdown {
  position: relative;
  display: inline-flex;
  align-items: flex-start;
  justify-content: center
}

.address-action-toggle {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  color: #333;
  font-size: 20px;
  line-height: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background .2s ease, color .2s ease
}

.address-actions-dropdown .address-action-toggle {
  color: var(--primary)
}

.address-actions-dropdown:hover .address-action-toggle {
  color: var(--hov-primary)
}

.address-details {
  width: 80%
}

.address-action-menu {
  position: absolute;
  top: calc(25% + 6px);
  right: 0;
  left: auto;
  background: #fff;
  border: 1px solid rgba(0, 0, 0, .08);
  border-radius: 10px;
  box-shadow: 0 10px 20px rgba(0, 0, 0, .08);
  opacity: 0;
  visibility: hidden;
  transform: translateY(10px);
  transition: opacity .18s ease, transform .18s ease, visibility .18s ease;
  z-index: 2;
  display: flex;
  flex-direction: column
}

.address-actions-dropdown.open .address-action-menu {
  opacity: 1;
  visibility: visible;
  transform: translateY(0)
}

.h4-style {
  font-size: 1.5rem;
  font-weight: 600;
  color: #1f0300
}

@media (max-width:767.98px) {
  .address-actions-dropdown {
    width: 20%
  }

  .address-action-menu {
    position: absolute;
    top: calc(28% + 8px);
    right: 0;
    width: auto;
    min-width: 170px;
    max-width: 100%;
    border-radius: 14px;
    box-shadow: 0 14px 28px rgba(0, 0, 0, .14)
  }

  .address-action-button,
  .address-action-menu .dropdown-item {
    padding: 12px 16px;
    font-size: 15px
  }

  .mobile-view-auth-btns .steve-btn {
    padding: 6px 10px
  }
}

.address-actions {
  text-align: center
}

.address-action-menu .address-action-item {
  display: block;
  width: 100%;
  padding: 0;
  margin: 0
}

.address-action-menu .steve-btn {
  width: 100%;
  text-align: left;
  padding: 10px 14px;
  border: 0;
  background: 0 0;
  color: #333;
  font-size: 14px;
  cursor: pointer
}

.address-action-button:hover,
.address-action-menu .address-action-item:hover {
  background: rgba(0, 0, 0, .04);
  color: var(--primary)
}

.custom-address-dropdown {
  position: relative
}

.custom-address-toggle {
  font-size: 20px
}

.custom-address-menu {
  display: flex;
  flex-direction: column;
  padding: 10px;
  gap: 10px;
  max-width: max-content;
  min-width: auto
}

.custom-address-item {
  border-bottom: 1px solid rgba(0, 0, 0, .06)
}

.custom-address-item:last-child {
  border-bottom: none
}

.custom-address-form {
  margin: 0
}

.custom-address-button {
  width: 100%;
  text-align: left
}

.custom-address-button.action-btn {
  width: auto;
  text-align: center
}

.custom-address-delete {
  color: #dc3545
}

.address-action-button.text-danger {
  color: #dc3545
}

.address-action-menu form {
  margin: 0
}

.address-action-menu .action-buttons {
  display: flex;
  gap: 8px;
  padding: 8px
}

.address-action-menu .action-btn {
  flex-shrink: 0
}

.custom-address-menu .custom-address-form {
  margin: 0
}

.custom-address-menu .custom-address-form .action-btn,
.custom-address-menu .custom-address-item .action-btn {
  width: 36px;
  height: 36px;
  min-width: 36px;
  text-align: center
}

.custom-address-menu .custom-address-form .action-btn svg,
.custom-address-menu .custom-address-item .action-btn svg {
  width: 16px;
  height: 16px
}

